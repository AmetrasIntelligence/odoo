msgid "<i class=\"fa fa-exclamation-triangle text-danger\" role=\"img\" title=\"There is something wrong with the contract. Either there is no running contract for this employee or employee's contract is about to expire.\" aria-label=\"There is something wrong with the contract. Either there is no running contract for this employee or employee's contract is about to expire.\"/>"
msgstr "<i class=\"fa fa-exclamation-triangle text-danger\" role=\"img\" title=\"Il y a quelque chose qui cloche dans le contrat. Soit il n'y a pas de contrat en cours pour cet employé ou son contrat est sur le point d'expirer.\" aria-label=\"Il y a quelque chose qui cloche dans le contrat. Soit il n'y a pas de contrat en cours pour cet employé ou son contrat est sur le point d'expirer.\"/>"

#. module: hr_contract
#: model_terms:ir.ui.view,arch_db:hr_contract.hr_contract_view_form
msgid "<span attrs=\"{'invisible': ['|', ('calendar_mismatch', '=', False), ('state', '!=', 'open')]}\" class=\"fa fa-exclamation-triangle text-danger o_calendar_warning pl-3\">\n"
"                                        </span>\n"
"                                        <span class=\"o_calendar_warning_tooltip text-danger\">\n"
"                                            Calendar Mismatch : The employee's calendar does not match this contract's calendar. This could lead to unexpected behaviors.\n"
"                                        </span>"
msgstr "<span attrs=\"{'invisible': ['|', ('calendar_mismatch', '=', False), ('state', '!=', 'open')]}\" class=\"fa fa-exclamation-triangle text-danger o_calendar_warning pl-3\">\n"
"</span>\n"
"<span class=\"o_calendar_warning_tooltip text-danger\">\n"
"Incohérence entre les calendriers : le calendrier de l'employé ne correspond pas au calendrier de ce contrat. Cela pourrait conduire à des comportements inattendus.\n"
"</span>"

#. module: hr_contract
#: model_terms:ir.ui.view,arch_db:hr_contract.hr_hr_employee_view_form2
msgid "<span attrs=\"{'invisible': [('calendar_mismatch', '=', False)]}\" class=\"fa fa-exclamation-triangle text-danger o_calendar_warning pl-3\">\n"
"                            </span>\n"
"                            <span class=\"o_calendar_warning_tooltip text-danger\">\n"
"                                Calendar Mismatch : The employee's calendar does not match its current contract calendar. This could lead to unexpected behaviors.\n"
"                            </span>"
msgstr "<span attrs=\"{'invisible': [('calendar_mismatch', '=', False)]}\" class=\"fa fa-exclamation-triangle text-danger o_calendar_warning pl-3\">\n"
"</span>\n"
"<span class=\"o_calendar_warning_tooltip text-danger\">\n"
"Incohérence entre les calendriers : le calendrier de l'employé ne correspond pas à son calendrier de contrat actuel. Cela pourrait conduire à des comportements inattendus.\n"
"</span>"

